cat > .gitignore << 'EOF'
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild*/ 
[Ll]ogs/
UserSettings/
MemoryCaptures/
*.csproj
*.sln
*.user
*.pdb
*.mdb
*.opendb
*.VC.db
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
EOF
git add .gitignore
git commit -m "chore: add Unity .gitignore" || true
